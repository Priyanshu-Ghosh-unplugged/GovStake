{
  "version": 2,
  "builds": [
    {
      "src": "dashboard/package.json",
      "use": "@vercel/next"
    },
    {
      "src": "escrow-engine/src/index.ts",
      "use": "@vercel/node"
    },
    {
      "src": "arena-agent/agent.ts",
      "use": "@vercel/node"
    },
    {
      "src": "mcp-server/src/index.ts",
      "use": "@vercel/node"
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/escrow-engine/src/index.ts"
    },
    {
      "source": "/(.*)",
      "destination": "/dashboard/$1"
    }
  ]
}
